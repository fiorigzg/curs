# ============================================================
# CURS — Environment template
# ============================================================
# Скопируй в infra/.env и заполни. infra/.env в .gitignore.
#
# Логика:
#   - DOMAIN пустой → docker-compose.yml поднимает api на localhost:8000,
#     traefik dashboard на localhost:8080, без HTTPS.
#   - DOMAIN задан → дополнительно подключаешь docker-compose.prod.yml:
#     Traefik забирает 80/443, выпускает Let's Encrypt сертификат,
#     роутит https://api.${DOMAIN} → api, https://traefik.${DOMAIN} → dashboard.
# ============================================================

# ---------- Reverse proxy ----------
# Пустой → локалка. Заполни на проде (пример: curs.example.com).
DOMAIN=
# Email для Let's Encrypt ACME challenge (только для prod).
ACME_EMAIL=

# ---------- Postgres ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=curs
POSTGRES_USER=curs
# Сгенерируй: openssl rand -hex 32
POSTGRES_PASSWORD=change_me_dev_only

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
# Пустой = без пароля (dev). Заполни на проде.
REDIS_PASSWORD=

# ---------- API ----------
API_PORT=8000

# ---------- Traefik (dev) ----------
# Порт для dashboard в dev-режиме. На проде overlay убирает этот биндинг.
TRAEFIK_DASHBOARD_PORT=8088
# Сгенерируй: openssl rand -hex 64
JWT_SECRET=change_me_64_hex_chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# Сгенерируй ключ Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me_fernet_key

# CORS: какие origin'ы пускать. Comma-separated. Для мобилки Expo обычно достаточно "*" в dev.
CORS_ORIGINS=http://localhost:3000,http://localhost:19006

# ---------- External APIs ----------
# Дев-токен T-Invest (read-only sandbox).
# Получить: https://www.tbank.ru/invest/settings/api/
TINKOFF_DEV_TOKEN=
TINKOFF_SANDBOX=true

# CoinGecko: Demo-плана достаточно (30 req/min).
# Получить: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# ЦБ РФ — публичное API, без ключа.
CBR_BASE_URL=https://www.cbr.ru

# ---------- Workers ----------
# Интервал опроса котировок (сек). Минимум 10 (rate limit CoinGecko).
QUOTES_POLL_INTERVAL_SEC=12
RISK_METRICS_POLL_INTERVAL_SEC=300

# ---------- Logging ----------
LOG_LEVEL=INFO
# json для прода, console для dev.
LOG_FORMAT=console
